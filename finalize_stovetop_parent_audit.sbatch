#!/usr/bin/env bash
#SBATCH --job-name=stove-finalize
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:10:00
#SBATCH --chdir=/work/umass/shlomo_umass/dbenhamougol_umass/robocasa-integration
#SBATCH --output=/work/umass/shlomo_umass/dbenhamougol_umass/slurm_logs/%x-%j.out
#SBATCH --error=/work/umass/shlomo_umass/dbenhamougol_umass/slurm_logs/%x-%j.err
set -euo pipefail
exec /work/umass/shlomo_umass/dbenhamougol_umass/envs/robocasa-v3/bin/python \
  -m training.bc_task_vlm.summarize_stovetop_parent_workspace_audit \
  --input-dir training/bc_task_vlm/eval_runs/stovetop_parent_workspace_ab \
  --output training/bc_task_vlm/eval_runs/stovetop_parent_workspace_ab/summary.json
